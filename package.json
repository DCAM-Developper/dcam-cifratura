{
  "name": "@dcam/cifratura",
  "version": "0.3.0",
  "private": true,
  "description": "End-to-end encryption core of DCAM: envelopes DCR2/DCS2/DCM2, key hierarchy, passphrase (Argon2id), recovery (Shamir), authenticated recipient list, signed epoch transitions.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "SPEC.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser"
  },
  "dependencies": {
    "@hpke/core": "1.9.0",
    "libsodium-wrappers-sumo": "0.8.4",
    "shamir-secret-sharing": "0.0.4"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "@vitest/browser": "3.2.4",
    "playwright": "1.60.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "esbuild": "0.28.2"
  }
}
